<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.frayground</groupId>
  <artifactId>frayground</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Frayground</name>
  <description>Frayground laboratory platform</description>

  <properties>
    <java.version>21</java.version>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
  </properties>

  <modules>
    <module>frayground-domain</module>
    <module>frayground-engine</module>
    <module>frayground-agent</module>
    <module>frayground-application</module>
    <module>frayground-game-spi</module>
    <module>frayground-game-connectfour</module>
    <module>frayground-game-blackjack</module>
    <module>frayground-storage-memory</module>
    <module>frayground-adapter-model</module>
    <module>frayground-web</module>
    <module>frayground-app</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
